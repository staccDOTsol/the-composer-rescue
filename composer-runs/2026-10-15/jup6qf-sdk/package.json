{
  "name": "@jup-ag/lend",
  "version": "0.4.0",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./earn": {
      "types": "./dist/earn/index.d.mts",
      "default": "./dist/earn/index.mjs"
    },
    "./borrow": {
      "types": "./dist/borrow/index.d.mts",
      "default": "./dist/borrow/index.mjs"
    },
    "./dex": {
      "types": "./dist/dex/index.d.mts",
      "default": "./dist/dex/index.mjs"
    },
    "./flashloan": {
      "types": "./dist/flashloan/index.d.mts",
      "default": "./dist/flashloan/index.mjs"
    },
    "./api": {
      "types": "./dist/api/index.d.mts",
      "default": "./dist/api/index.mjs"
    },
    "./refinance": {
      "types": "./dist/refinance/index.d.mts",
      "default": "./dist/refinance/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "vitest dev",
    "lint": "eslint . && prettier -c .",
    "lint:fix": "automd && eslint . --fix && prettier -w .",
    "prepack": "pnpm build",
    "release": "pnpm test && changelogen --release && npm publish && git push --follow-tags",
    "test": "pnpm test:types && vitest run --coverage",
    "test:types": "tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^3.2.6",
    "automd": "^0.4.3",
    "changelogen": "^0.6.1",
    "eslint": "^9.39.4",
    "eslint-config-unjs": "^0.4.2",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^3.0.9"
  },
  "packageManager": "pnpm@10.7.0",
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.18.0",
    "bn.js": "^5.2.3"
  }
}
